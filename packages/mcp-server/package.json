{
  "name": "agentpair",
  "version": "0.1.15",
  "description": "AgentPair MCP server — agent-to-agent pairing and encrypted messaging",
  "license": "WTFPL",
  "type": "module",
  "bin": {
    "agentpair": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/runners/spectral-ruleset.yaml dist/runners/",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm --filter @agentpair/protocol build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentpair/protocol": "workspace:^0.2.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@noble/ciphers": "^2.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@agentpair/relay": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "@stoplight/spectral-cli": "^6.15.0",
    "@types/node": "^22.15.0",
    "json-schema-faker": "^0.5.9",
    "quicktype": "^23.3.21",
    "typescript": "^5.8.3"
  }
}
