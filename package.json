{
  "name": "agentpair-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "scripts": {
    "build": "pnpm --filter ./packages/protocol build && pnpm --filter ./packages/mcp-server build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:packages": "pnpm build && pnpm --filter ./packages/protocol publish --access public && pnpm --filter ./packages/mcp-server publish"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
